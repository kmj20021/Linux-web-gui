# --- OS 및 에디터 관련 ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- 백엔드 (Python/FastAPI) 관련 ---
backend/.venv/
backend/venv/
backend/core/__pycache__/
backend/routers/__pycache__/
backend/schemas/__pycache__/
backend/services/__pycache__/
backend/test/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# --- 프론트엔드 (Node/Vite) 관련 ---
frontend/node_modules/
frontend/dist/
frontend/.common/
frontend/.cache/

# --- 로그 및 환경 변수 (보안상 중요) ---
*.log
.env
.env.*

# --- 실행 DB (추적 제외, 로컬 파일은 보존) ---
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# --- 개인 작업 및 히스토리에서 제거한 파일 ---
nul

# --- 도커 관련 ---
.docker/

# --- ai ---
# AI 작업 노트(계획·진행 기록·평가)는 저장소에 넣지 않는다.
*.md
.claude
docs/*

# 단, README 가 참조하는 운영·계약·학습 문서는 저장소에 포함한다.
!docs/operations.md
!docs/db-operations.md
!docs/contracts/
!docs/contracts/**
!docs/tutorials/
!docs/tutorials/**
